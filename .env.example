# Same Supabase project as peam-web. Copy this file to `.env` and fill in
# Dashboard → Project Settings → API.
#
# Use the project URL only (no /rest/v1/). Use the anon / publishable key.
# Never put the service_role key in this file.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Maps SDK for Android / iOS (optional until you enable the Google Cloud APIs).
# GPS geofencing still works without this key.
GOOGLE_MAPS_API_KEY=your-google-maps-key
